# ALM Market Voice — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Tavily (web crawling & search) ──────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key-here

# ── watsonx.ai (LLM enrichment — primary) ───────────────────────────────────
# IBM internal — use your IBM Cloud API key and watsonx project ID
# Model: meta-llama/llama-3-3-70b-instruct (available on Lite plan)
# Rate limit: 10 concurrent free requests; backend retries automatically
WATSONX_API_KEY=your-ibm-cloud-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Ollama (LLM enrichment — free local fallback) ────────────────────────────
# Automatic fallback when watsonx is rate-limited. Runs on Apple Silicon.
# Setup: brew install ollama && ollama pull llama3.2
# No API key needed — leave these as defaults unless you've changed your setup.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Anthropic Claude (optional — requires personal Anthropic account) ─────────
# IBM employees cannot use IBM's Claude Desktop gateway as an API.
# If you have a personal Anthropic API key from console.anthropic.com, add it here.
# Leave blank to skip (Ollama is used instead).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ── OpenAI (optional — requires personal OpenAI account with credits) ─────────
# Leave blank to skip.
OPENAI_API_KEY=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://almuser:almpassword@localhost:5432/alm_market_voice

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-random-string-in-production
CORS_ORIGINS=http://localhost:5173
